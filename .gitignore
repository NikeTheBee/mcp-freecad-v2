__pycache__/
*.pyc
*.FCBak
.vscode/


# Third-party FreeCAD workbenches (grafts) — cloned locally, not vendored
/addons/

# Local, machine-specific agent settings
.claude/settings.local.json

# Secrets — never commit (cyber / NF5 / §13). Defense in depth.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
secrets.*
*.secret

# Per-project runtime artifacts from the home-grown layers (keep the dirs, not the data)
/project_state/*.json
# the state's backup, lock and temp files hold the same project memory
/project_state/*.json.*
/exports/
/checkpoints/*.FCStd
/checkpoints/*.FCStd[0-9]*
/recovery/
/projects/
/recipes/
/renders/

# Runtime output of examples/resume_between_sessions.py
/examples/demo_state/

# Machine-local launcher config (absolute user paths)
/.claude/launch.json

# Workshop environments (detached to MCPFC_HOME by install/atelier_install.py)
/.pixi/
sbom.cdx.json
# Local pointer for agents that read CLAUDE.md (it only imports AGENTS.md)
/CLAUDE.md
